{
  "name": "@11vertex/directus-extension-permission-auditor",
  "version": "1.0.1",
  "description": "Directus permission auditor: scan every role and policy for risky access, such as public data, unrestricted deletes and admins without 2FA, with fixes",
  "icon": "policy",
  "license": "MIT",
  "author": {
    "name": "11Vertex",
    "url": "https://github.com/11Vertex"
  },
  "contributors": [
    {
      "name": "Kashyap Thaker",
      "url": "https://github.com/kashyap-thakar"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/11Vertex/directus-extensions.git",
    "directory": "packages/directus-extension-permission-auditor"
  },
  "homepage": "https://github.com/11Vertex/directus-extensions/tree/main/packages/directus-extension-permission-auditor#readme",
  "bugs": {
    "url": "https://github.com/11Vertex/directus-extensions/issues"
  },
  "keywords": [
    "directus",
    "directus-extension",
    "directus-extension-bundle",
    "directus-extension-module",
    "permissions",
    "access-policies",
    "security",
    "audit",
    "security-audit",
    "rbac",
    "compliance",
    "admin-tool"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "directus:extension": {
    "type": "bundle",
    "path": {
      "app": "dist/app.js",
      "api": "dist/api.js"
    },
    "entries": [
      {
        "type": "module",
        "name": "permission-auditor-module",
        "source": "src/module/index.js"
      },
      {
        "type": "endpoint",
        "name": "permission-auditor",
        "source": "src/api/index.js"
      }
    ],
    "host": "^11.0.0 || ^12.0.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "link": "directus-extension link",
    "validate": "directus-extension validate",
    "test": "node --test src/**/*.test.js"
  },
  "peerDependencies": {
    "directus": "^11.0.0 || ^12.0.0"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "14.0.0",
    "vue": "^3.5.17"
  },
  "publishConfig": {
    "access": "public"
  }
}
