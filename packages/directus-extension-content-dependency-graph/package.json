{
  "name": "@11vertex/directus-extension-content-dependency-graph",
  "version": "1.0.1",
  "description": "Directus content dependency graph: see how collections and items connect, preview what a delete would do, and find orphaned or broken content",
  "icon": "account_tree",
  "license": "MIT",
  "author": {
    "name": "11Vertex",
    "url": "https://github.com/11Vertex"
  },
  "contributors": [
    {
      "name": "Kashyap Thaker",
      "url": "https://github.com/kashyap-thakar"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/11Vertex/directus-extensions.git",
    "directory": "packages/directus-extension-content-dependency-graph"
  },
  "homepage": "https://github.com/11Vertex/directus-extensions/tree/main/packages/directus-extension-content-dependency-graph#readme",
  "bugs": {
    "url": "https://github.com/11Vertex/directus-extensions/issues"
  },
  "keywords": [
    "directus",
    "directus-extension",
    "directus-extension-bundle",
    "directus-extension-module",
    "relations",
    "dependency-graph",
    "data-model",
    "orphans",
    "delete-impact",
    "schema",
    "visualization",
    "admin-tool"
  ],
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "directus:extension": {
    "type": "bundle",
    "path": {
      "app": "dist/app.js",
      "api": "dist/api.js"
    },
    "entries": [
      {
        "type": "module",
        "name": "content-dependency-graph-module",
        "source": "src/module/index.js"
      },
      {
        "type": "endpoint",
        "name": "content-dependency-graph",
        "source": "src/api/index.js"
      }
    ],
    "host": "^10.10.0 || ^11.0.0 || ^12.0.0"
  },
  "scripts": {
    "build": "directus-extension build",
    "dev": "directus-extension build -w --no-minify",
    "link": "directus-extension link",
    "validate": "directus-extension validate",
    "test": "node --test src/**/*.test.js"
  },
  "peerDependencies": {
    "directus": "^10.10.0 || ^11.0.0 || ^12.0.0"
  },
  "devDependencies": {
    "@directus/extensions-sdk": "14.0.0",
    "vue": "^3.5.17"
  },
  "publishConfig": {
    "access": "public"
  }
}
